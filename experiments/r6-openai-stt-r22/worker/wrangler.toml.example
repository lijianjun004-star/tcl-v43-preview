name = "tcl-r6-openai-stt-private"
main = "index.mjs"
compatibility_date = "2026-11-16"

# DO NOT add actual API keys, access codes or shared secrets to this file.
# Bind a Cloudflare KV namespace named ASR_USAGE_KV for best-effort daily limits.
# KV is NOT atomic; use account-side OpenAI spending controls too.

[vars]
ALLOWED_ORIGIN = "https://lijianjun004-star.github.io"
DAILY_MAX_REQUESTS = "5"
ASR_BILLING_ENABLED = "false"

# Secrets to be set via `wrangler secret put`, only after user authorization:
# OPENAI_API_KEY, ASR_ACCESS_TOKEN