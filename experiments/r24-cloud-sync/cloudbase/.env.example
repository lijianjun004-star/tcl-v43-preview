# Default provider is the existing gateway. To use native Shanghai Hunyuan set
# TCL_R24_SYNC_AI_MODEL_PROVIDER=cloudbase and TCL_R24_SYNC_AI_MODEL_ID=hy3.
# Legacy preview uses the explicit pair hunyuan-v3 / hy3-preview.
TCL_R24_SYNC_AI_MODEL_PROVIDER=openai_gateway
TCL_R24_SYNC_AI_MODEL_ID=

# Set on the pilot function at runtime. Use a gateway approved for the intended traffic.
# Example URL shape: https://gateway.example.invalid/v1/chat/completions
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
AI_GATEWAY_MODEL=gpt-4o-mini
AI_GATEWAY_TIMEOUT_MS=30000
AI_FALLBACK_ENABLED=true

# Operator IDs: comma-separated stable IDs, or "*" for every active operator.
# Daily limit: empty means no cap; 1-10000 caps HTTP attempts per Shanghai day
# (above 20 needs schema-ai-drafts-limit.sql).
TCL_R24_SYNC_AI_ENABLED=false
TCL_R24_SYNC_AI_OPERATOR_IDS=
TCL_R24_SYNC_AI_DAILY_LIMIT=5
