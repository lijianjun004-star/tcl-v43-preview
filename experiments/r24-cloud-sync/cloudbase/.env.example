# Set on the pilot function at runtime. Use a gateway approved for the intended traffic.
# Example URL shape: https://gateway.example.invalid/v1/chat/completions
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
AI_GATEWAY_MODEL=gpt-4o-mini
AI_GATEWAY_TIMEOUT_MS=60000
AI_FALLBACK_ENABLED=true

# Enable only for verified stable operator IDs. Daily limit counts HTTP attempts.
TCL_R24_SYNC_AI_ENABLED=false
TCL_R24_SYNC_AI_OPERATOR_IDS=
TCL_R24_SYNC_AI_DAILY_LIMIT=5
